# NVIDIA hosted API (https://build.nvidia.com) or a local NIM container.
NVIDIA_API_KEY=nvapi-your-key-here
# Hosted default. For a local NIM use http://localhost:8000/v1 (the key can be a dummy value).
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# meta/llama-3.1-70b-instruct is end-of-life on the hosted API (HTTP 410); this one was verified with tool calling.
EMPORIO_MODEL=mistralai/mistral-large-4-1t-a52b
